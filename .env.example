# run.sh writes the real bot .env itself; this documents the keys it sets.
# The bot token is read from ~/.config/tg-qa/feedback.bot-token (NOT committed).

BOT_TOKEN=                    # from @BotFather (~/.config/tg-qa/feedback.bot-token)
ADMIN_CHAT_ID=-5306171913    # chat the bot relays user messages to (negative for groups)
REMOVE_SENT_CONFIRMATION=no  # keep the "Сообщение отправлено!" reply so snapshots can assert it
WEBHOOK_DOMAIN=              # empty = long polling (no public host needed)
WEBHOOK_PATH=
CUSTOM_BOT_API=
